{
	"type": "object",
	"description": "Entry of the CrowdSec allowlist \"npmplus\", applied by the crowdsec-helper container",
	"properties": {
		"id": {
			"type": "integer",
			"minimum": 1
		},
		"value": {
			"description": "IPv4/IPv6 address or CIDR range, normalised on save",
			"type": "string",
			"minLength": 2,
			"maxLength": 64,
			"pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$",
			"example": "192.0.2.10"
		},
		"description": {
			"type": "string",
			"maxLength": 255,
			"pattern": "^[^\\r\\n\\t\\u0000-\\u001f\\u007f]*$",
			"example": "Office"
		},
		"expires_at": {
			"description": "Expiration (ISO 8601), null = never",
			"type": [
				"string",
				"null"
			],
			"maxLength": 40,
			"example": "2030-01-01T00:00:00.000Z"
		},
		"created_on": {
			"type": [
				"string",
				"null"
			]
		}
	}
}
