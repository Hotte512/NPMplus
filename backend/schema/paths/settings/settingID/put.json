{
	"operationId": "updateSetting",
	"summary": "Update a setting",
	"tags": [
		"settings"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "settingID",
			"schema": {
				"type": "string",
				"minLength": 1,
				"enum": [
					"default-site",
					"unifi-dns"
				]
			},
			"required": true,
			"description": "Setting ID",
			"example": "default-site"
		}
	],
	"requestBody": {
		"description": "Setting Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"allOf": [
						{
							"if": {
								"properties": {
									"value": {
										"const": "redirect"
									}
								},
								"required": [
									"value"
								]
							},
							"then": {
								"properties": {
									"meta": {
										"required": [
											"redirect"
										],
										"properties": {
											"redirect": {
												"minLength": 1
											}
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"value": {
										"const": "html"
									}
								},
								"required": [
									"value"
								]
							},
							"then": {
								"properties": {
									"meta": {
										"required": [
											"html"
										],
										"properties": {
											"html": {
												"minLength": 1
											}
										}
									}
								}
							}
						}
					],
					"properties": {
						"value": {
							"type": "string",
							"minLength": 1,
							"enum": [
								"congratulations",
								"404",
								"444",
								"redirect",
								"html",
								"enabled",
								"disabled"
							],
							"example": "html"
						},
						"meta": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"redirect": {
									"type": "string",
									"maxLength": 255,
									"pattern": "^\\S*$"
								},
								"html": {
									"type": "string"
								},
								"status": {
									"type": "integer",
									"minimum": 400,
									"maximum": 599
								},
								"url": {
									"type": "string",
									"maxLength": 255,
									"pattern": "^(https?://\\S+)?$"
								},
								"api_key": {
									"type": "string",
									"maxLength": 255
								},
								"api_key_set": {
									"type": "boolean"
								},
								"site_id": {
									"type": "string",
									"maxLength": 64,
									"pattern": "^[a-zA-Z0-9-]*$"
								},
								"default_target": {
									"type": "string",
									"maxLength": 255,
									"pattern": "^[a-zA-Z0-9.:-]*$"
								},
								"verify_tls": {
									"type": "boolean"
								},
								"ttl": {
									"type": "integer",
									"minimum": 0,
									"maximum": 86400
								}
							},
							"example": {
								"html": "<p>hello world</p>"
							}
						}
					}
				},
				"example": {
					"value": "congratulations",
					"meta": {}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": "default-site",
								"name": "Default Site",
								"description": "What to show when Nginx is hit with an unknown Host",
								"value": "congratulations",
								"meta": {}
							}
						}
					},
					"schema": {
						"$ref": "../../../components/setting-object.json"
					}
				}
			}
		}
	}
}
