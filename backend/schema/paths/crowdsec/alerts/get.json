{
	"operationId": "getCrowdsecAlerts",
	"summary": "Get the latest alerts (needs a machine login)",
	"tags": [
		"crowdsec"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "ip",
			"description": "Only alerts of this ip",
			"schema": {
				"type": "string",
				"maxLength": 64,
				"pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$",
				"minLength": 2
			}
		},
		{
			"in": "query",
			"name": "scenario",
			"description": "Only alerts of this scenario",
			"schema": {
				"type": "string",
				"maxLength": 255,
				"pattern": "^[^\\r\\n]*$"
			}
		},
		{
			"in": "query",
			"name": "limit",
			"description": "Maximum number of alerts",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 1000,
				"default": 100
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "array",
						"items": {
							"type": "object"
						}
					}
				}
			}
		}
	}
}
