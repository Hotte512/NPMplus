{
	"operationId": "createCrowdsecDecision",
	"summary": "Ban an ip or range (needs a machine login)",
	"tags": [
		"crowdsec"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"value",
						"type",
						"duration"
					],
					"properties": {
						"value": {
							"type": "string",
							"maxLength": 64,
							"pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
						},
						"type": {
							"type": "string",
							"enum": [
								"ban",
								"captcha"
							]
						},
						"duration": {
							"type": "string",
							"pattern": "^[1-9][0-9]{0,5}[smh]$",
							"example": "4h"
						},
						"reason": {
							"type": "string",
							"maxLength": 255
						}
					}
				}
			}
		}
	},
	"responses": {
		"201": {
			"description": "201 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "boolean"
					}
				}
			}
		}
	}
}
