{
	"operationId": "checkCrowdsecAllowlist",
	"summary": "Check whether an ip or range is on an allowlist of the local api (needs a machine login)",
	"tags": [
		"crowdsec"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "query",
			"name": "value",
			"required": true,
			"description": "IP address or CIDR range",
			"schema": {
				"type": "string",
				"minLength": 2,
				"maxLength": 64,
				"pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "object",
						"properties": {
							"value": {
								"type": "string"
							},
							"allowlisted": {
								"type": "boolean"
							},
							"reason": {
								"type": "string"
							}
						}
					}
				}
			}
		}
	}
}
