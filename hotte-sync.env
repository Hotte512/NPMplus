# upstream repository
UPSTREAM=ZoeyVid/NPMplus
# branch in this fork holding the own feature commits
FEATURES_BRANCH=claude/hotte-features
# upstream commit FEATURES_BRANCH is based on, update it whenever FEATURES_BRANCH is rebased
# (with BASE=release every commit after it is replayed onto the latest release)
FEATURES_BASE=50adf2a84db1e00dd57f7d299d3abfb28a0af1f5
# pinned:  build FEATURES_BRANCH as it is, upstream develop is rebased into it on purpose (develop gets rewritten often)
# release: replay the feature commits onto the latest upstream release, once releases are cut from the new develop
BASE=pinned
